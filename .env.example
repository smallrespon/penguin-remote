# PenguinHarness owner 路由基址（会话 API 与档位清单都走它）。
# 同机部署必须是 http://localhost/...（127.0.0.1 是预览端口，API 请求一律 401）。
OWNER_API_BASE_URL=http://localhost/api

# 默认绑定的 Project / Agent（聊天未显式切换时使用）。
DEFAULT_PROJECT_ID=default_project
DEFAULT_AGENT_ID=default_agent

# 可执行文件位置（已在 PATH 时可留空取默认值）。
# PENGUIN_BIN=penguin
# LARK_CLI_BIN=lark-cli

# 运行时状态目录（bindings.json / runs.jsonl）。
STATE_DIR=state

# 访问控制：允许与机器人对话的 chat_id / open_id，逗号分隔。留空 = 开放访问（见 README 风险提示）。
# ALLOWLIST=oc_xxx,ou_xxx

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# owner 会话令牌（penguin auth token）：TTL 与提前重铸的余量，秒。
OWNER_TOKEN_TTL_SECONDS=3600
OWNER_TOKEN_REFRESH_MARGIN_SECONDS=300

# 流式预览节流：距上次编辑 ≥ 该毫秒数，或累积 ≥ 该字符数，才编辑一次；超过上限则截断。
PREVIEW_THROTTLE_MS=1500
PREVIEW_THROTTLE_CHARS=300
PREVIEW_MAX_CHARS=3500

# HTML 页交付（ADR-0012）：富内容自动渲染器，指向 answer-me-with-html 插件技能里的 am.mjs。
# 未配置 = 关闭自动渲染（Agent 自己产出的 .html 页面仍会作为文件消息转发）。
# AMWH_RENDER_SCRIPT=/root/.penguin/data/default_project/agents/default_agent/agent_state/skills/answer-me-with-html/scripts/am.mjs
